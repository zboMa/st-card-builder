---
import Layout from '../layouts/Layout.astro';
---
<Layout title="管理端 · 啊哈哈哈制卡器">
  <div class="admin-app" id="adminApp">
    <div id="adminLoginGate" class="auth-login-screen auth-login-screen--full" aria-live="polite">
      <div class="auth-login-ambient" aria-hidden="true"></div>
      <div class="auth-login-panel">
        <div class="auth-login-mark" aria-hidden="true"></div>
        <p class="auth-login-brand">啊哈哈哈制卡器</p>
        <p class="auth-login-kicker">管理端</p>
        <h1 class="auth-login-title">登录后继续</h1>
        <p class="auth-login-lead">使用已授权的管理员账号登录。</p>

        <div id="adminEmailAuthBox" class="auth-login-email" hidden>
          <form id="formAdminEmailLogin" class="auth-login-form" autocomplete="on">
            <label for="adminEmailLoginEmail">邮箱</label>
            <input id="adminEmailLoginEmail" name="email" type="email" required autocomplete="username" placeholder="you@example.com" />
            <label for="adminEmailLoginPassword">密码</label>
            <input id="adminEmailLoginPassword" name="password" type="password" required autocomplete="current-password" placeholder="至少 8 位" />
            <button type="submit" class="btn btn-primary auth-login-cta" id="btnAdminEmailLogin">登录</button>
          </form>
          <p class="auth-login-hint">管理员请先在主站用邀请码注册，并把邮箱写入服务器 <code>ADMIN_EMAILS</code>。</p>
        </div>

        <a class="btn btn-primary auth-login-cta" id="btnAdminDiscordLogin" href="#" hidden>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M20.317 4.37a19.8 19.8 0 0 0-4.885-1.515.07.07 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.3 18.3 0 0 0-5.487 0 12.6 12.6 0 0 0-.617-1.25.08.08 0 0 0-.079-.037A19.7 19.7 0 0 0 3.677 4.37a.09.09 0 0 0-.04.04C.533 9.047-.32 13.58.099 18.057a.08.08 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.08.08 0 0 0 .084-.028 14 14 0 0 0 1.226-1.994.08.08 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.08.08 0 0 1-.008-.128c.126-.094.252-.192.372-.292a.07.07 0 0 1 .078-.01c3.928 1.793 8.18 1.793 12.062 0a.07.07 0 0 1 .079.01c.12.098.246.198.373.292a.08.08 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.892.08.08 0 0 0-.041.107c.36.698.772 1.363 1.225 1.993a.08.08 0 0 0 .084.028 19.8 19.8 0 0 0 6.002-3.03.08.08 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.06.06 0 0 0-.04-.04zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
          使用 Discord 登录
        </a>
        <div class="auth-login-actions" id="adminLoginExtra" hidden>
          <button type="button" id="btnAdminGateLogout" class="btn btn-ghost btn-sm">退出当前账号</button>
        </div>
        <p class="auth-login-tip" id="adminGateTip">正在校验登录状态…</p>
        <a class="auth-login-back" id="btnAdminBackApp" href="#">返回主站</a>
      </div>
    </div>

    <div id="adminWorkspace" hidden>
      <header class="admin-head">
        <div class="admin-brand">
          <strong>啊哈哈哈制卡器 · 管理端</strong>
          <span class="admin-muted" id="adminUserLine">—</span>
        </div>
        <div class="admin-actions">
          <a class="btn btn-ghost btn-sm" id="btnAdminBackAppTop" href="#">返回应用</a>
          <button type="button" id="btnAdminLogout" class="btn btn-ghost btn-sm">退出</button>
        </div>
      </header>

      <div id="adminReasonDialog" class="admin-dialog" hidden>
        <form id="adminReasonForm">
          <strong id="adminReasonTitle">填写原因</strong>
          <label for="adminReasonText">原因</label>
          <textarea id="adminReasonText" rows="4" required></textarea>
          <div class="admin-actions">
            <button type="submit" class="btn btn-primary">确定</button>
            <button type="button" class="btn btn-ghost" id="adminReasonCancel">取消</button>
          </div>
        </form>
      </div>

      <div id="adminBanner" class="admin-banner" hidden></div>
      <div id="adminStatus" class="admin-status" aria-live="polite"></div>

      <div id="adminShell" class="admin-layout">
        <nav class="admin-nav" aria-label="管理导航" id="adminNav"></nav>

        <div class="admin-main">
          <section class="admin-panel" data-admin-view="dashboard">
            <h2>仪表盘</h2>
            <div id="adminDashGrid" class="admin-status-list"></div>
            <p id="adminDashFlags" class="admin-muted"></p>
            <div id="adminTrendBox" class="admin-trend-box"></div>
          </section>

          <section class="admin-panel" data-admin-view="users" hidden>
            <div class="admin-panel-head">
              <h2>用户管理</h2>
            </div>
            <form class="admin-query">
              <label>关键字
                <input id="adminUserQ" type="search" placeholder="邮箱、名字、userId、Discord" />
              </label>
              <label>状态
                <select id="adminUserStatus">
                  <option value="all">全部</option>
                  <option value="active">正常</option>
                  <option value="disabled">已禁用</option>
                </select>
              </label>
              <button type="submit" id="btnAdminLoadUsers" class="btn btn-primary">查询</button>
              <button type="button" class="btn btn-ghost" data-admin-reset>重置</button>
            </form>
            <div id="adminUserProfile"></div>
            <div id="adminUserTable"></div>
          </section>

          <section class="admin-panel" data-admin-view="cards" hidden>
            <div class="admin-panel-head">
              <h2>卡管理</h2>
            </div>
            <form class="admin-query">
              <label>关键字
                <input id="adminCardQ" type="search" placeholder="卡名、cardId、userId" />
              </label>
              <label>NSFW
                <select id="adminCardNsfw">
                  <option value="all">全部</option>
                  <option value="yes">是</option>
                  <option value="no">否</option>
                </select>
              </label>
              <label>状态
                <select id="adminCardStatus">
                  <option value="all">全部</option>
                  <option value="active">正常</option>
                  <option value="removed">已下架</option>
                </select>
              </label>
              <label>用户
                <input id="adminCardUser" type="search" placeholder="userId" />
              </label>
              <button type="submit" id="btnAdminLoadCards" class="btn btn-primary">查询</button>
              <button type="button" class="btn btn-ghost" data-admin-reset>重置</button>
            </form>
            <div id="adminCardDetail"></div>
            <div id="adminCardTable"></div>
          </section>

          <section class="admin-panel" data-admin-view="novels" hidden>
            <div class="admin-panel-head">
              <h2>小说管理</h2>
            </div>
            <form class="admin-query">
              <label>关键字
                <input id="adminNovelQ" type="search" placeholder="标题、novelId、cardId、userId" />
              </label>
              <label>状态
                <select id="adminNovelStatus">
                  <option value="all">全部</option>
                  <option value="active">正常</option>
                  <option value="removed">已下架</option>
                </select>
              </label>
              <label>用户
                <input id="adminNovelUser" type="search" placeholder="userId" />
              </label>
              <button type="submit" id="btnAdminLoadNovels" class="btn btn-primary">查询</button>
              <button type="button" class="btn btn-ghost" data-admin-reset>重置</button>
            </form>
            <div id="adminNovelDetail"></div>
            <div id="adminNovelTable"></div>
          </section>

          <section class="admin-panel" data-admin-view="shares" hidden>
            <div class="admin-panel-head">
              <h2>分享管理</h2>
            </div>
            <form class="admin-query">
              <label>关键字
                <input id="adminShareQ" type="search" placeholder="token、目标名、主人" />
              </label>
              <label>类型
                <select id="adminShareType">
                  <option value="all">全部</option>
                  <option value="card-share">卡</option>
                  <option value="novel-share">小说</option>
                </select>
              </label>
              <label>状态
                <select id="adminShareStatus">
                  <option value="all">全部</option>
                  <option value="active">有效</option>
                  <option value="disabled">已停</option>
                  <option value="expired">已过期</option>
                </select>
              </label>
              <button type="submit" id="btnAdminLoadShares" class="btn btn-primary">查询</button>
              <button type="button" class="btn btn-ghost" data-admin-reset>重置</button>
            </form>
            <div id="adminShareDetail"></div>
            <div id="adminShareTable"></div>
          </section>

          <section class="admin-panel" data-admin-view="tokens" hidden>
            <div class="admin-panel-head">
              <h2>插件 Bearer Token</h2>
              <button type="button" id="btnAdminPurgeTokens" class="btn btn-sm btn-ghost admin-ops-only">清理过期</button>
            </div>
            <form class="admin-query">
              <label>用户
                <input id="adminTokenQ" type="search" placeholder="用户、Discord" />
              </label>
              <label>状态
                <select id="adminTokenStatus">
                  <option value="all">全部</option>
                  <option value="active">有效</option>
                  <option value="expired">过期</option>
                </select>
              </label>
              <button type="submit" id="btnAdminLoadTokens" class="btn btn-primary">查询</button>
              <button type="button" class="btn btn-ghost" data-admin-reset>重置</button>
            </form>
            <div id="adminTokenTable"></div>
          </section>

          <section class="admin-panel" data-admin-view="databases" hidden>
            <div class="admin-panel-head">
              <h2>Couch 库</h2>
              <button type="button" id="btnAdminLoadDbs" class="btn btn-sm btn-fetch">刷新</button>
            </div>
            <div id="adminDbAnalysis" class="admin-mb"></div>
            <div id="adminDbTable"></div>
          </section>

          <section class="admin-panel" data-admin-view="audit" hidden>
            <div class="admin-panel-head">
              <h2>审计日志</h2>
              <button type="button" id="btnAdminExportAudit" class="btn btn-sm btn-ghost">导出 JSON</button>
            </div>
            <form class="admin-query">
              <label>操作者
                <input id="adminAuditBy" type="search" />
              </label>
              <label>动作
                <select id="adminAuditAction">
                  <option value="">全部动作</option>
                  <option value="user.disable">禁用用户</option>
                  <option value="user.enable">启用用户</option>
                  <option value="content.card.disable">下架卡</option>
                  <option value="share.disable">停用分享</option>
                  <option value="share.force_delete">删除分享映射</option>
                  <option value="token.revoke">撤销 Token</option>
                  <option value="backup.run">备份</option>
                </select>
              </label>
              <label>对象用户
                <input id="adminAuditUser" type="search" placeholder="userId" />
              </label>
              <button type="submit" id="btnAdminLoadAudit" class="btn btn-primary">查询</button>
              <button type="button" class="btn btn-ghost" data-admin-reset>重置</button>
            </form>
            <div id="adminAuditTable"></div>
          </section>

          <section class="admin-panel" data-admin-view="moderation" hidden>
            <div class="admin-panel-head">
              <h2>审核与审批</h2>
            </div>
            <div id="adminModerationBody"></div>
          </section>

          <section class="admin-panel" data-admin-view="tasks" hidden>
            <div class="admin-panel-head">
              <h2>定时任务</h2>
            </div>
            <div id="adminTaskTable"></div>
          </section>

          <section class="admin-panel" data-admin-view="backup" hidden>
            <div class="admin-panel-head">
              <h2>备份</h2>
              <button type="button" id="btnAdminBackup" class="btn btn-primary admin-ops-only">立即备份</button>
            </div>
            <div id="adminBackupBody"></div>
          </section>

          <section class="admin-panel" data-admin-view="system" hidden>
            <div class="admin-panel-head">
              <h2>进程</h2>
            </div>
            <div id="adminSystemBody"></div>
          </section>

          <section class="admin-panel" data-admin-view="roles" hidden>
            <div class="admin-panel-head">
              <h2>角色管理</h2>
            </div>
            <div id="adminRoleTable"></div>
          </section>

          <section class="admin-panel" data-admin-view="menus" hidden>
            <div class="admin-panel-head">
              <h2>菜单管理</h2>
            </div>
            <div id="adminMenuTable"></div>
          </section>

          <section class="admin-panel" data-admin-view="oplog" hidden>
            <div class="admin-panel-head">
              <h2>操作日志</h2>
            </div>
            <form class="admin-query">
              <label>操作者
                <input id="adminOpLogWho" type="search" />
              </label>
              <label>路径
                <input id="adminOpLogAction" type="search" placeholder="路径或动作" />
              </label>
              <button type="submit" id="btnAdminLoadOpLog" class="btn btn-primary">查询</button>
              <button type="button" class="btn btn-ghost" data-admin-reset>重置</button>
            </form>
            <div id="adminOpLogTable"></div>
          </section>

          <section class="admin-panel" data-admin-view="loginlog" hidden>
            <div class="admin-panel-head">
              <h2>登录日志</h2>
            </div>
            <form class="admin-query">
              <label>谁
                <input id="adminLoginLogWho" type="search" placeholder="用户或邮箱" />
              </label>
              <label>结果
                <select id="adminLoginLogOk">
                  <option value="all">全部</option>
                  <option value="ok">成功</option>
                  <option value="fail">失败</option>
                </select>
              </label>
              <button type="submit" id="btnAdminLoadLoginLog" class="btn btn-primary">查询</button>
              <button type="button" class="btn btn-ghost" data-admin-reset>重置</button>
            </form>
            <div id="adminLoginLogTable"></div>
          </section>

          <section class="admin-panel" data-admin-view="params" hidden>
            <div class="admin-panel-head">
              <h2>参数管理</h2>
              <button type="button" id="btnAdminLoadParams" class="btn btn-sm btn-fetch">刷新</button>
            </div>
            <div id="adminParamTable"></div>
          </section>

          <section class="admin-panel" data-admin-view="dicts" hidden>
            <div class="admin-panel-head">
              <h2>数据字典</h2>
              <button type="button" id="btnAdminLoadDicts" class="btn btn-sm btn-fetch">刷新</button>
            </div>
            <div id="adminDictTable"></div>
          </section>

          <section class="admin-panel" data-admin-view="invites" hidden>
            <div class="admin-panel-head">
              <h2>邀请码</h2>
            </div>
            <div class="admin-query-row">
              <form class="admin-query">
                <label>状态
                  <select id="adminInviteStatus">
                    <option value="all">全部</option>
                    <option value="valid">有效</option>
                    <option value="used">已用</option>
                    <option value="revoked">已作废</option>
                  </select>
                </label>
                <button type="submit" id="btnAdminLoadInvites" class="btn btn-primary">查询</button>
                <button type="button" class="btn btn-ghost" data-admin-reset>重置</button>
              </form>
              <form class="admin-query">
                <label>备注
                  <input id="adminInviteNote" type="search" />
                </label>
                <label>数量
                  <input id="adminInviteCount" type="number" value="1" min="1" />
                </label>
                <label>过期天数
                  <input id="adminInviteDays" type="number" value="7" min="0" />
                </label>
                <button type="button" id="btnAdminGenInvites" class="btn btn-primary">生成</button>
              </form>
            </div>
            <div id="adminInviteTable"></div>
          </section>

          <section class="admin-panel" data-admin-view="quota" hidden>
            <div class="admin-panel-head">
              <h2>配额</h2>
            </div>
            <form class="admin-query">
              <label>档位
                <select id="adminQuotaTier">
                  <option value="all">全部</option>
                  <option value="registered">registered</option>
                  <option value="member">member</option>
                  <option value="admin">admin</option>
                </select>
              </label>
              <label>范围
                <select id="adminQuotaOver">
                  <option value="">全部</option>
                  <option value="1">只看超限</option>
                </select>
              </label>
              <button type="submit" id="btnAdminLoadQuota" class="btn btn-primary">查询</button>
              <button type="button" class="btn btn-ghost" data-admin-reset>重置</button>
            </form>
            <div id="adminQuotaTiers"></div>
            <div id="adminQuotaTable"></div>
          </section>

          <section class="admin-panel" data-admin-view="files" hidden>
            <div class="admin-panel-head">
              <h2>文件</h2>
            </div>
            <form class="admin-query">
              <label>来源
                <select id="adminFileSource">
                  <option value="all">全部</option>
                  <option value="backup">备份</option>
                  <option value="export">导出</option>
                  <option value="upload">上传</option>
                </select>
              </label>
              <label>文件名
                <input id="adminFileName" type="search" />
              </label>
              <label>上传
                <input id="adminFileData" type="file" />
              </label>
              <button type="submit" id="btnAdminLoadFiles" class="btn btn-primary">查询</button>
              <button type="button" id="btnAdminUploadFile" class="btn btn-ghost">上传</button>
            </form>
            <div id="adminFileTable"></div>
          </section>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  @import '../styles/auth-login.css';
  @import '../styles/admin.css';
</style>

<script>
  document.documentElement.classList.add('admin-html');
  document.body.classList.add('admin-body');
</script>
<script>
  import '../lib/admin/browserApp.mjs';
</script>
