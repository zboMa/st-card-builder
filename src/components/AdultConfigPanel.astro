---
import AdultConfigPanel from './adultConfig/AdultConfigPanel.vue';
---

<AdultConfigPanel client:only="vue" />

<style is:global>
  .area-adult-config {
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  /* 面板标题 + 说明段固定，内容在其下滚动 */
  .area-adult-config .adult-config-head {
    position: sticky;
    top: calc(-1 * var(--space-5));
    z-index: 6;
    margin: calc(-1 * var(--space-5)) calc(-1 * var(--space-5)) 0;
    padding: var(--space-5) var(--space-5) 6px;
    background: color-mix(in srgb, var(--color-glass, var(--color-surface)) 92%, var(--color-bg, #0a0d12) 8%);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .adult-worldframe-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 10px 0 12px;
    margin: 8px 0 4px;
    border-top: 1px dashed var(--color-border);
    border-bottom: 1px dashed var(--color-border);
  }
  .adult-worldframe-refresh-hint {
    flex: 1 1 100%;
    margin: 0;
  }
  .adult-config-lead {
    margin: -4px 0 14px;
    font-size: 0.78rem;
    line-height: 1.5;
  }
  .adult-wv-section {
    margin-bottom: 4px;
  }
  .char-nsfw-block {
    padding: 2px 0 6px;
  }
  .char-nsfw-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 10px;
  }
  .char-nsfw-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-accent);
    white-space: nowrap;
  }
  .adult-flavor-section,
  .adult-expression-section,
  .adult-ntl-section {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px dashed var(--color-border);
  }
  .adult-dashed-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 8px;
  }
  .adult-dashed-item {
    padding: 8px 10px;
    border: 1px dashed var(--color-border);
    border-radius: 8px;
    background: transparent;
  }
  .adult-dashed-item-head {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .adult-dashed-item-meta {
    flex: 1;
    min-width: 0;
  }
  .adult-dashed-item-title {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .adult-dashed-item-title .adult-dashed-tag {
    margin-left: 6px;
    font-size: 0.65rem;
    font-weight: 500;
    color: var(--color-accent);
  }
  .adult-dashed-item-desc {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    line-height: 1.45;
    margin-top: 3px;
  }
  .adult-dashed-item-actions {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }
  .adult-dashed-remove {
    font-size: 0.65rem;
    padding: 1px 6px;
    color: var(--color-text-muted);
    opacity: 0.65;
    border: none;
    background: transparent;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .adult-dashed-remove:hover {
    opacity: 1;
    color: var(--color-text);
  }
  .adult-dashed-move {
    font-size: 0.65rem;
    padding: 1px 4px;
    color: var(--color-text-muted);
    opacity: 0.55;
    border: none;
    background: transparent;
    cursor: pointer;
  }
  .adult-dashed-move:hover { opacity: 1; }
  .adult-dashed-item textarea {
    width: 100%;
    margin-top: 6px;
    font-size: 0.7rem;
    padding: 4px 7px;
    border-radius: 6px;
    border: 1px dashed var(--color-border);
    background: var(--color-bg, var(--color-surface));
    color: var(--color-text);
    resize: vertical;
    min-height: 2.2em;
  }
  .adult-add-spacer {
    flex: 1 1 auto;
  }
  .btn.adult-add-btn {
    flex: 0 0 auto;
    font-size: 0.7rem;
    padding: 2px 8px;
    white-space: nowrap;
    box-shadow: none;
  }
  .btn.adult-add-btn:hover {
    box-shadow: none;
  }
  .adult-select-compact {
    flex: 0 1 auto;
    min-width: 0;
    max-width: 180px;
    font-size: 0.7rem;
    padding: 2px 6px;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
  }
  .adult-btn-compact {
    font-size: 0.7rem !important;
    padding: 2px 8px !important;
  }
  .char-nsfw-flavor-line {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .char-nsfw-sub {
    font-size: 0.76rem;
    color: var(--color-accent);
    font-weight: 700;
  }
  .char-nsfw-subtitle {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }
  .adult-pref-tip {
    margin: 0 0 8px;
    padding: 6px 8px;
    border-left: 2px solid var(--color-accent, #8a7a5a);
    background: color-mix(in srgb, var(--color-surface) 88%, var(--color-accent, #8a7a5a) 12%);
    border-radius: 0 6px 6px 0;
  }
  .adult-pref-tip strong {
    font-weight: 700;
    color: var(--color-text);
  }
  .char-corruption-block {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px dashed var(--color-border);
  }
  .char-corruption-targets {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    max-height: 140px;
    overflow: auto;
    padding: 4px 0;
  }
  .char-corruption-targets label {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.72rem;
    color: var(--color-text);
    cursor: pointer;
  }
  .adult-wv-empty {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    padding: 4px 0;
  }
  /* 兼容旧 class：口味/NTL 列表渲染可复用虚线卡 */
  .adult-flavor-list { display: contents; }
  .adult-flavor-item { /* unused; list uses adult-dashed-item */ }

  /* 世界与限定 · 新增条目弹窗 */
  .app-confirm-overlay .adult-add-dialog {
    width: min(760px, 100%);
    display: flex;
    flex-direction: column;
    max-height: min(82vh, 660px);
  }
  .adult-add-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .adult-add-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 18px 10px;
    flex: 0 0 auto;
  }
  .adult-add-head .app-confirm-title {
    margin: 0;
    white-space: nowrap;
  }
  .adult-add-subtitle {
    flex: 1;
    min-width: 0;
    font-size: 0.7rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }
  .adult-add-close {
    flex: 0 0 auto;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }
  .adult-add-close:hover {
    color: var(--color-text);
    border-color: var(--color-accent);
  }
  .adult-add-form {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 18px 4px;
    flex: 0 0 auto;
  }
  .adult-add-form select {
    font-size: 0.74rem;
    padding: 5px 8px;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
  }
  .adult-add-group {
    flex: 0 0 auto;
    width: 148px;
  }
  .adult-add-item {
    flex: 1 1 auto;
    min-width: 0;
  }
  .adult-add-form .btn.adult-add-confirm {
    flex: 0 0 auto;
    font-size: 0.74rem;
    padding: 5px 12px;
    white-space: nowrap;
    box-shadow: none;
  }
  .adult-add-form .btn.adult-add-confirm:hover {
    box-shadow: none;
  }
  .adult-add-actions .btn.btn-ghost {
    font-size: 0.74rem;
    padding: 5px 12px;
    box-shadow: none;
  }
  .adult-add-actions .btn.btn-ghost:hover {
    box-shadow: none;
  }
  .adult-add-preview {
    display: none;
    margin: 8px 18px 0;
    padding: 8px 10px;
    border-radius: 8px;
    border: 1px dashed var(--color-border);
    background: color-mix(in srgb, var(--color-surface) 72%, var(--color-accent, #8a7a5a) 8%);
    font-size: 0.72rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }
  .adult-add-preview.show {
    display: block;
  }
  .adult-add-preview-title {
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 2px;
  }
  .adult-add-pv-content {
    max-height: 200px;
    overflow-y: auto;
    overscroll-behavior: contain;
    margin-top: 4px;
  }
  .adult-add-pv-sum {
    color: var(--color-text-secondary);
    margin-bottom: 4px;
    font-weight: 500;
  }
  .adult-add-pv-block {
    margin-top: 6px;
    padding-top: 5px;
    border-top: 1px solid var(--color-border-subtle);
  }
  .adult-add-pv-label {
    font-weight: 700;
    font-size: 0.68rem;
    color: var(--color-accent, #8a7a5a);
    margin-bottom: 2px;
  }
  .adult-add-pv-text {
    color: var(--color-text-muted);
    white-space: pre-wrap;
    word-break: break-word;
  }
  .adult-add-note {
    margin: 8px 18px 0;
  }
  .adult-add-note textarea {
    width: 100%;
    font-size: 0.7rem;
    padding: 4px 8px;
    border-radius: 6px;
    border: 1px dashed var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    resize: vertical;
    min-height: 2.2em;
  }
  .adult-add-selected-head {
    margin: 12px 18px 6px;
    padding-top: 10px;
    border-top: 1px solid var(--color-border);
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--color-accent);
  }
  .adult-add-selected-list {
    margin: 0 18px;
    padding: 2px 2px 6px;
  }
  .adult-add-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px 16px;
    flex: 0 0 auto;
  }
  .adult-add-msg {
    flex: 1;
    min-width: 0;
    font-size: 0.7rem;
    color: var(--color-text-muted);
    min-height: 1em;
  }
  .adult-select-host {
    display: contents;
  }
</style>
