---
/**
 * 状态栏：左四步同屏，右预览。变量与排版在各自标题行生成。
 */
---
<div class="panel statusbar-panel" id="statusbarPanel">
  <div class="panel-header statusbar-panel-head">
    <h2>状态栏</h2>
  </div>
  <div class="sb-toolbar">
    <button type="button" class="btn btn-ghost btn-inline btn-expand-preview" id="sbBtnPreviewPrompt" title="查看提示词" aria-label="查看提示词"><svg class="icon-expand-corners" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M21 8V5a2 2 0 0 0-2-2h-3"/><path d="M3 16v3a2 2 0 0 0 2 2h3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/></svg></button>
    <button type="button" class="btn btn-inline" id="sbBtnSampleFloors">生成3楼样例变量数据</button>
  </div>

  <div class="sb-layout">
    <ol class="sb-rail">
      <li class="sb-step" data-sb-step="1">
        <span class="ui-step-pill sb-step-mark" data-sb-mark="1"><span>1</span></span>
        <div class="sb-step-body">
          <h3>人物</h3>
          <div class="sb-line">
            <label class="sb-check" for="sbIncludeProtagonist">
              <input type="checkbox" id="sbIncludeProtagonist" checked />
              <span>主角</span>
            </label>
            <span class="ui-hint ui-hint--inline" id="sbCharName">#</span>
          </div>
          <div class="sb-line">
            <label class="sb-check" for="sbIncludeFemales">
              <input type="checkbox" id="sbIncludeFemales" />
              <span>女角色</span>
            </label>
            <button type="button" class="btn btn-inline" id="sbFemaleOnly" aria-pressed="true">只识别女</button>
            <button type="button" class="btn btn-inline" id="sbBtnScanChars">AI 识别</button>
          </div>
          <div id="sbCharList" class="sb-char-list"></div>
        </div>
      </li>

      <li class="sb-step" data-sb-step="2">
        <span class="ui-step-pill sb-step-mark" data-sb-mark="2"><span>2</span></span>
        <div class="sb-step-body">
          <h3>预设</h3>
          <label class="sb-check" for="sbNsfw">
            <input type="checkbox" id="sbNsfw" />
            <span>NSFW</span>
          </label>
          <div id="sbPresetGrid" class="sb-presets"></div>
          <div class="sb-line">
            <span class="sb-k">模块</span>
            <button type="button" class="btn btn-inline" id="sbBtnResetModules">重置</button>
          </div>
          <div id="sbModuleGrid" class="sb-modules"></div>
        </div>
      </li>

      <li class="sb-step" data-sb-step="3">
        <span class="ui-step-pill sb-step-mark" data-sb-mark="3"><span>3</span></span>
        <div class="sb-step-body">
          <div class="sb-step-head">
            <h3>变量</h3>
            <button type="button" class="btn btn-inline" id="sbBtnVars">生成</button>
          </div>
          <label class="sb-k" for="sbExtra">额外要求</label>
          <textarea id="sbExtra" rows="2" placeholder="如：强调契约进度"></textarea>
        </div>
      </li>

      <li class="sb-step" data-sb-step="4">
        <span class="ui-step-pill sb-step-mark" data-sb-mark="4"><span>4</span></span>
        <div class="sb-step-body">
          <div class="sb-step-head">
            <h3>排版</h3>
            <div class="sb-step-actions">
              <button type="button" class="btn btn-inline" id="sbBtnLayoutRegen">重新生成</button>
              <button type="button" class="btn btn-inline" id="sbBtnLayoutRevise">修改</button>
            </div>
          </div>
          <label class="sb-k" for="sbLayoutPrompt">排版风格说明</label>
          <textarea id="sbLayoutPrompt" rows="4" placeholder="如：窄条清单，数值用细进度条"></textarea>
        </div>
      </li>
    </ol>

    <section class="sb-preview-pane">
      <div class="assistant-mode-switch" id="sbViewSwitch" data-mode="preview" role="tablist" aria-label="预览、变量与注入脚本">
        <span class="assistant-mode-switch__thumb" aria-hidden="true"></span>
        <button type="button" class="assistant-mode-switch__btn is-active" role="tab" aria-selected="true" data-sb-view="preview">预览</button>
        <button type="button" class="assistant-mode-switch__btn" role="tab" aria-selected="false" data-sb-view="vars">变量</button>
        <button type="button" class="assistant-mode-switch__btn" role="tab" aria-selected="false" data-sb-view="script">注入脚本</button>
      </div>
      <div class="sb-view-pane" data-sb-view-pane="preview">
        <p class="ui-hint" id="sbPreviewHint">尚无样例</p>
        <iframe id="sbPreviewFrame" class="sb-preview-frame" title="状态栏预览" sandbox="allow-same-origin"></iframe>
        <div class="sb-floor-nav">
          <button type="button" class="btn btn-inline" id="sbFloorPrev">上一楼</button>
          <span id="sbFloorLabel">尚无样例</span>
          <button type="button" class="btn btn-inline" id="sbFloorNext">下一楼</button>
        </div>
      </div>
      <div class="sb-view-pane" data-sb-view-pane="vars" hidden>
        <div id="sbVarTree" class="sb-tree"></div>
      </div>
      <div class="sb-view-pane" data-sb-view-pane="script" hidden>
        <pre id="sbSnippetCode" class="sb-code"></pre>
      </div>
    </section>
  </div>
</div>

<style is:global>
  .statusbar-panel-head h2 { margin: 0; }
  .sb-toolbar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
  }
  .sb-layout {
    display: grid;
    grid-template-columns: minmax(280px, 42%) minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }
  @media (max-width: 960px) {
    .sb-layout { grid-template-columns: 1fr; }
  }
  .sb-rail {
    list-style: none;
    margin: 0 0 0 11px;
    padding: 0 0 0 18px;
    border-left: 2px solid var(--color-accent);
  }
  .sb-step { position: relative; padding: 0 0 var(--space-4); }
  .sb-step > .ui-step-pill {
    position: absolute;
    left: -18px;
    top: 0;
    transform: translateX(-50%);
    padding: 0;
    pointer-events: none;
    cursor: default;
  }
  .sb-step h3 {
    margin: 0 0 var(--space-2);
    font-size: 0.84rem;
  }
  .sb-step-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin: 0 0 var(--space-2);
  }
  .sb-step-head h3 { margin: 0; }
  .sb-step-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
  }
  .sb-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }
  .sb-check {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-text-secondary);
    font-size: 0.76rem;
    cursor: pointer;
  }
  .sb-check input { accent-color: var(--color-accent); }
  .sb-k {
    display: block;
    margin-bottom: 4px;
    color: var(--color-text-muted);
    font-size: 0.7rem;
    font-weight: 700;
  }
  .sb-line .sb-k { margin: 0; }
  .statusbar-panel textarea {
    width: 100%;
    margin-bottom: var(--space-2);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-subtle);
    background: var(--color-surface-input);
    color: var(--color-text);
    padding: 6px 8px;
    font: inherit;
    font-size: 0.76rem;
  }
  .sb-char-list, .sb-modules, .sb-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: var(--space-2);
  }
  .sb-module-group {
    flex: 1 0 100%;
  }
  .sb-module-group__items {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .sb-presets .btn.is-active {
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
    border-color: var(--color-accent-border);
  }
  .statusbar-panel .assistant-mode-switch {
    grid-template-columns: repeat(3, 1fr);
    min-width: 196px;
    margin: 0 0 var(--space-2) 0;
  }
  .statusbar-panel .assistant-mode-switch__thumb {
    width: calc((100% - 4px) / 3);
  }
  .statusbar-panel .assistant-mode-switch[data-mode="vars"] .assistant-mode-switch__thumb {
    transform: translateX(100%);
  }
  .statusbar-panel .assistant-mode-switch[data-mode="script"] .assistant-mode-switch__thumb {
    transform: translateX(200%);
  }
  .sb-view-pane[hidden] { display: none !important; }
  .sb-tree {
    min-height: 380px;
    max-height: min(62vh, 640px);
    overflow: auto;
    padding: 8px 10px;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    background: var(--color-paper-deep);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.55;
  }
  .sb-tree-node { margin-left: 12px; }
  .sb-tree > .sb-tree-node { margin-left: 0; }
  .sb-tree summary {
    display: flex;
    align-items: baseline;
    gap: 6px;
    cursor: pointer;
    list-style: none;
  }
  .sb-tree summary::-webkit-details-marker { display: none; }
  .sb-tree summary::before {
    content: '▸';
    width: 0.8em;
    color: var(--color-text-muted);
  }
  .sb-tree details[open] > summary::before { content: '▾'; }
  .sb-tree-key { color: var(--color-text); }
  .sb-tree-sep { color: var(--color-text-muted); }
  .sb-tree-str { color: var(--color-warning); }
  .sb-tree-num { color: var(--color-accent); font-weight: 650; }
  .sb-tree-meta {
    color: var(--color-text-muted);
    font-size: 0.64rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: 999px;
    padding: 0 6px;
  }
  .sb-tree-row {
    display: flex;
    gap: 6px;
    margin-left: 1.15em;
  }
  .sb-tree .ui-hint { margin: 8px 0; }
  .sb-preview-frame {
    width: 100%;
    min-height: 380px;
    height: min(62vh, 640px);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    background: var(--color-paper-deep);
  }
  .sb-floor-nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-2) 0;
    color: var(--color-text-muted);
    font-size: 0.72rem;
  }
  .sb-code {
    margin: 0;
    min-height: 380px;
    max-height: min(62vh, 640px);
    overflow: auto;
    padding: 8px 10px;
    border-radius: var(--radius-md);
    background: var(--color-paper-deep);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-warning);
    font-size: 0.64rem;
    white-space: pre-wrap;
    font-family: var(--font-mono);
  }
</style>

<script>
  import { initStatusBarPanel } from '../lib/statusBar/panelBoot.mjs';
  initStatusBarPanel();
</script>
