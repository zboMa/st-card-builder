---
/**
 * 状态栏：Vue 岛负责 UI；设计与生成由 panelBoot 桥接 cardStore。
 */
import StatusBarPanelVue from './statusBar/StatusBarPanel.vue';
---
<StatusBarPanelVue client:only="vue" />

<style is:global>
  .statusbar-panel-head h2 { margin: 0; }
  .sb-toolbar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
  }
  .sb-layout {
    display: grid;
    grid-template-columns: minmax(280px, 42%) minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }
  @media (max-width: 960px) {
    .sb-layout { grid-template-columns: 1fr; }
  }
  .sb-rail {
    list-style: none;
    margin: 0 0 0 11px;
    padding: 0 0 0 18px;
    border-left: 2px solid var(--color-accent);
  }
  .sb-step { position: relative; padding: 0 0 var(--space-4); }
  .sb-step > .ui-step-pill {
    position: absolute;
    left: -18px;
    top: 0;
    transform: translateX(-50%);
    padding: 0;
    pointer-events: none;
    cursor: default;
  }
  .sb-step h3 {
    margin: 0 0 var(--space-2);
    font-size: 0.84rem;
  }
  .sb-step-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin: 0 0 var(--space-2);
  }
  .sb-step-head h3 { margin: 0; }
  .sb-step-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
  }
  .sb-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }
  .sb-check {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-text-secondary);
    font-size: 0.76rem;
    cursor: pointer;
  }
  .sb-check input { accent-color: var(--color-accent); }
  .sb-k {
    display: block;
    margin-bottom: 4px;
    color: var(--color-text-muted);
    font-size: 0.7rem;
    font-weight: 700;
  }
  .sb-line .sb-k { margin: 0; }
  .statusbar-panel textarea {
    width: 100%;
    margin-bottom: var(--space-2);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-subtle);
    background: var(--color-surface-input);
    color: var(--color-text);
    padding: 6px 8px;
    font: inherit;
    font-size: 0.76rem;
  }
  .sb-char-list, .sb-modules, .sb-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: var(--space-2);
  }
  .sb-module-group {
    flex: 1 0 100%;
  }
  .sb-module-group__items {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .sb-presets .btn.is-active {
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
    border-color: var(--color-accent-border);
  }
  .statusbar-panel .assistant-mode-switch {
    grid-template-columns: repeat(3, 1fr);
    min-width: 196px;
    margin: 0 0 var(--space-2) 0;
  }
  .statusbar-panel .assistant-mode-switch__thumb {
    width: calc((100% - 4px) / 3);
  }
  .statusbar-panel .assistant-mode-switch[data-mode="vars"] .assistant-mode-switch__thumb {
    transform: translateX(100%);
  }
  .statusbar-panel .assistant-mode-switch[data-mode="script"] .assistant-mode-switch__thumb {
    transform: translateX(200%);
  }
  .sb-view-pane[hidden] { display: none !important; }
  .sb-tree {
    min-height: 380px;
    max-height: min(62vh, 640px);
    overflow: auto;
    padding: 8px 10px;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    background: var(--color-paper-deep);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.55;
  }
  .sb-tree-node { margin-left: 12px; }
  .sb-tree > .sb-tree-node { margin-left: 0; }
  .sb-tree summary {
    display: flex;
    align-items: baseline;
    gap: 6px;
    cursor: pointer;
    list-style: none;
  }
  .sb-tree summary::-webkit-details-marker { display: none; }
  .sb-tree summary::before {
    content: '▸';
    width: 0.8em;
    color: var(--color-text-muted);
  }
  .sb-tree details[open] > summary::before { content: '▾'; }
  .sb-tree-key { color: var(--color-text); }
  .sb-tree-sep { color: var(--color-text-muted); }
  .sb-tree-str { color: var(--color-warning); }
  .sb-tree-num { color: var(--color-accent); font-weight: 650; }
  .sb-tree-meta {
    color: var(--color-text-muted);
    font-size: 0.64rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: 999px;
    padding: 0 6px;
  }
  .sb-tree-row {
    display: flex;
    gap: 6px;
    margin-left: 1.15em;
  }
  .sb-tree .ui-hint { margin: 8px 0; }
  .sb-preview-frame {
    width: 100%;
    min-height: 380px;
    height: min(62vh, 640px);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    background: var(--color-paper-deep);
  }
  .sb-floor-nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-2) 0;
    color: var(--color-text-muted);
    font-size: 0.72rem;
  }
  .sb-code {
    margin: 0;
    min-height: 380px;
    max-height: min(62vh, 640px);
    overflow: auto;
    padding: 8px 10px;
    border-radius: var(--radius-md);
    background: var(--color-paper-deep);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-warning);
    font-size: 0.64rem;
    white-space: pre-wrap;
    font-family: var(--font-mono);
  }
</style>
