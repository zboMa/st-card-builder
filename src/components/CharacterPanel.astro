---
/** 角色设定：编辑当前卡主角字段；多卡切换在「角色卡管理」；成人配置见侧栏「成人配置」 */
import PreviewPanel from './PreviewPanel.astro';
---
<div class="panel area-character">
  <div class="character-config-head">
    <div class="panel-header character-panel-head">
      <h2>角色设定</h2>
      <span id="charTokenCount" class="tok-text" title="角色设定字段总 token" aria-live="polite"></span>
      <div class="panel-header__end">
        <button type="button" id="btnOpenJsonPreview" class="btn btn-panel-tool" title="查看当前卡 JSON">JSON</button>
        <button type="button" id="btnOpenAiEngine" class="btn btn-ai-engine" title="打开 AI 引擎">AI 引擎</button>
        <span id="saveIndicator" class="panel-header__badge character-saved" style="display: none;">已保存</span>
      </div>
    </div>
    <p class="ui-hint character-config-lead">
      本页只编辑<strong>主角</strong>卡面字段（名、描述、标签、版本等），不会写入世界书人物档案。
      世界观预设、载体框架、口味、姿势语言、情趣话风、NTL、恶堕请到「世界与限定」配置——那些内容不进主角 Description。
      <button type="button" id="btnGotoWorldLimitsFromCharacter" class="ai-engine-link-btn">去「世界与限定」配置</button>
    </p>
  </div>

  <!-- 头像 + 基础信息：左栏头像；右栏字段 + 卡面条（紧跟标签，全宽破出） -->
  <div class="character-layout">
    <div class="character-layout__aside">
      <div class="avatar-upload avatar-upload--aside">
        <div class="avatar-upload__preview">
          <span id="avatarPlaceholder" class="avatar-upload__placeholder">无图</span>
          <img id="avatarImg" class="avatar-upload__img" style="display: none;" alt="avatar" />
        </div>
        <div class="avatar-upload__actions">
          <label id="charAvatarUploadLabel" class="btn btn-panel-tool avatar-upload__file-btn" for="charImageInput" title="添加卡面（将嵌入 PNG 卡片）">添加卡面</label>
          <input type="file" id="charImageInput" accept="image/*" hidden />
          <button type="button" id="btnOpenAvatarImageGen" class="btn btn-ai-engine" title="用 AI 生图生成头像（需先在 AI 配置配置生图服务商）">AI 生成头像</button>
        </div>
        <p class="avatar-upload__hint">当前草稿使用的卡面会嵌入 PNG</p>
      </div>
    </div>

    <div class="character-layout__right">
    <div class="character-layout__main">
      <div class="grid-2">
        <div class="form-group">
          <label>角色名 (Name)</label>
          <input type="text" id="charName" placeholder="角色名称" />
        </div>
        <div class="form-group">
          <label>世界书名 (Worldbook)</label>
          <input type="text" id="wbName" placeholder="世界书名称" />
        </div>
      </div>

      <div class="form-group">
        <div class="char-tags-label-row">
          <label for="characterVersion">卡片版本 (character_version)</label>
          <span class="ui-hint ui-hint--inline">酒馆字段；发布/分享按此版本固化。不可手改，请用按钮升级。</span>
        </div>
        <div class="character-version-row">
          <input type="text" id="characterVersion" value="1.0" readonly tabindex="-1" title="仅可通过右侧按钮升级；SillyTavern data.character_version" />
          <button type="button" id="btnBumpVersionMajor" class="btn btn-meta" title="大版本 +1，小版本归零">升级大版本</button>
          <button type="button" id="btnBumpVersionMinor" class="btn btn-meta" title="小版本 +1">升级小版本</button>
          <button type="button" id="btnRevertVersion" class="btn btn-meta" hidden title="恢复到修改前的版本">回退</button>
        </div>
      </div>

      <!-- 角色标签：对接 ST tags / data.tags -->
      <div class="form-group char-tags-group">
        <div class="char-tags-label-row">
          <label for="charTagInput">角色标签 (Tags)</label>
          <span class="ui-hint ui-hint--inline char-tags-tip">ST tags / data.tags</span>
        </div>
        <div class="form-section char-tags-section">
          <div id="charTagsList" class="chip-list char-tags-list" aria-live="polite"></div>
          <div class="char-tags-add-row">
            <input type="text" id="charTagInput" class="char-tag-input" placeholder="输入标签，回车添加" autocomplete="off" />
            <button type="button" id="btnAddCharTag" class="btn btn-meta">添加</button>
            <button type="button" id="btnAiGenCharTags" class="btn btn-panel-tool btn-ai-tag">AI 生成</button>
          </div>
        </div>
      </div>
    </div>

    <div class="avatar-gallery avatar-gallery--strip" aria-labelledby="avatarGalleryHeading">
      <div class="avatar-gallery__head">
        <span id="avatarGalleryHeading" class="avatar-gallery__title">卡面列表</span>
        <span id="avatarGalleryCount" class="avatar-gallery__count ui-hint ui-hint--inline">0/20</span>
      </div>
      <div id="avatarGalleryList" class="avatar-gallery__list" role="list"></div>
    </div>
    </div>
  </div>

  <hr class="divider character-panel-divider" />

  <div class="form-group">
    <div class="ui-label-row">
      <label>角色描述 (Description)</label>
      <span id="charDescTok" class="tok-text" title="角色描述 token" aria-live="polite"></span>
    </div>
    <textarea id="charDesc" style="min-height: 130px;" placeholder="主角的外貌、性格、背景故事（请勿写入 NSFW / 恶堕分期）..."></textarea>
  </div>

  <hr class="divider" />

  <div class="form-group">
    <div class="ui-label-row">
      <label>作者注释 (Creator Notes)</label>
      <span id="creatorNotesTok" class="tok-text" title="作者注释 token" aria-live="polite"></span>
    </div>
    <textarea id="creatorNotes" placeholder="给使用者的说明..."></textarea>
  </div>
</div>

<div id="jsonPreviewModal" class="panel-feature-modal" hidden aria-hidden="true">
  <div class="ui-modal-backdrop" data-json-preview-close aria-hidden="true"></div>
  <div class="ui-modal-dialog panel-feature-modal__dialog panel-feature-modal__dialog--wide" role="dialog" aria-modal="true" aria-labelledby="jsonPreviewModalTitle">
    <div class="panel-feature-modal__head">
      <h2 id="jsonPreviewModalTitle">JSON 实时追踪</h2>
      <button type="button" class="btn-icon btn-icon--sm" data-json-preview-close aria-label="关闭">×</button>
    </div>
    <div class="panel-feature-modal__body">
      <PreviewPanel />
    </div>
  </div>
</div>

<div id="avatarImageGenModal" class="panel-feature-modal" hidden aria-hidden="true">
  <div class="ui-modal-backdrop" data-avimg-close aria-hidden="true"></div>
  <div class="ui-modal-dialog panel-feature-modal__dialog panel-feature-modal__dialog--wide" role="dialog" aria-modal="true" aria-labelledby="avatarImageGenModalTitle">
    <div class="panel-feature-modal__head">
      <h2 id="avatarImageGenModalTitle">AI 生成头像</h2>
      <button type="button" class="btn-icon btn-icon--sm" data-avimg-close aria-label="关闭">×</button>
    </div>
    <div class="panel-feature-modal__body avatar-img-gen-body">
      <div id="avatarImgGenMeta" class="avatar-img-gen-meta"></div>
      <div class="form-group">
        <label for="imgGenPrompt">正向提示词</label>
        <textarea id="imgGenPrompt" rows="3" placeholder="1girl, portrait, ..."></textarea>
      </div>
      <div id="imgGenNegativeRow" class="form-group" style="display:none;">
        <label for="imgGenNegative">负面提示词</label>
        <input type="text" id="imgGenNegative" placeholder="nsfw, lowres, blurry..." />
      </div>
      <div class="img-gen-actions">
        <button type="button" id="btnImgGenLlm" class="btn btn-fetch">用角色描述生成提示词</button>
        <button type="button" id="btnImgGenRun" class="btn btn-primary">生成</button>
      </div>
      <div id="imgGenStatus" class="img-gen-status" aria-live="polite"></div>
      <div id="imgGenGrid" class="img-gen-grid"></div>
    </div>
  </div>
</div>

<style is:global>
  .panel-header__end {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }
  /* 标题 + 说明段固定（同世界与限定）：面板内滚动，顶区毛玻璃吸顶 */
  .area-character .character-config-head {
    position: sticky;
    top: calc(-1 * var(--space-5));
    z-index: 6;
    margin: calc(-1 * var(--space-5)) calc(-1 * var(--space-5)) 0;
    padding: var(--space-5) var(--space-5) 6px;
    background: color-mix(in srgb, var(--color-glass, var(--color-surface)) 92%, var(--color-bg, #0a0d12) 8%);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .area-character .character-panel-head {
    margin: 0;
    padding: 0 0 4px;
  }
  .character-config-lead {
    margin: -4px 0 10px;
    font-size: 0.78rem;
    line-height: 1.5;
  }
  .character-config-lead .ai-engine-link-btn {
    display: inline;
    margin-left: 0.35em;
    vertical-align: baseline;
  }
  /* 头像 + 右栏：左窄栏；右栏内字段与卡面条纵向紧排，卡面全宽破出至面板边 */
  .character-layout {
    --character-aside-w: 132px;
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    margin-bottom: var(--space-2);
  }
  .character-layout__aside {
    flex: 0 0 var(--character-aside-w);
    min-width: 0;
  }
  .character-layout__right {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .character-layout__main {
    min-width: 0;
  }
  .character-layout__main .grid-2 {
    margin-bottom: var(--space-2);
  }
  .character-layout__main .form-group {
    margin-bottom: var(--space-2);
  }
  .avatar-upload--aside {
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-2);
    margin-bottom: 0;
  }
  .avatar-upload--aside .avatar-upload__preview {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-md);
  }
  .avatar-upload--aside .avatar-upload__img {
    object-fit: cover;
  }
  .avatar-upload--aside .avatar-upload__actions {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 0;
  }
  .avatar-upload--aside .avatar-upload__actions .btn {
    width: 100% !important;
  }
  .avatar-upload__hint {
    font-size: 0.62rem;
    color: var(--color-text-muted);
    margin: 0;
    text-align: center;
  }
  .avatar-upload__file-btn.is-disabled {
    opacity: 0.45;
    pointer-events: none;
  }
  .avatar-gallery {
    width: 100%;
    min-width: 0;
  }
  .avatar-gallery--strip {
    margin: 4px 0 0;
    padding: var(--space-2) 0 0;
    border-top: 1px solid var(--color-border-subtle);
    width: calc(100% + var(--character-aside-w) + var(--space-4));
    margin-left: calc(-1 * (var(--character-aside-w) + var(--space-4)));
  }
  .avatar-gallery__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: 4px;
  }
  .avatar-gallery__title {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .avatar-gallery__count {
    margin: 0;
    font-size: 0.62rem;
  }
  .avatar-gallery__list {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    gap: 8px;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 4px;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }
  .avatar-gallery__empty {
    flex: 1 1 auto;
    margin: 0;
    font-size: 0.62rem;
    text-align: center;
    padding: 12px 0;
  }
  .avatar-gallery__tile-wrap {
    position: relative;
    flex: 0 0 auto;
    width: 72px;
  }
  .avatar-gallery__tile {
    display: block;
    width: 72px;
    height: 72px;
    aspect-ratio: 1;
    padding: 0;
    margin: 0;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: pointer;
    background: var(--color-surface-inset);
    position: relative;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .avatar-gallery__tile:hover {
    border-color: var(--color-border);
  }
  .avatar-gallery__tile.is-active {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-accent) 55%, transparent);
  }
  .avatar-gallery__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .avatar-gallery__tile-ph {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-size: 0.65rem;
    color: var(--color-text-muted);
  }
  .avatar-gallery__mark {
    position: absolute;
    left: 3px;
    bottom: 3px;
    font-size: 0.55rem;
    font-weight: 600;
    padding: 1px 4px;
    border-radius: 3px;
    line-height: 1.2;
    background: color-mix(in srgb, var(--color-bg) 72%, transparent);
    color: var(--color-text);
  }
  .avatar-gallery__mark.is-published {
    left: auto;
    right: 3px;
    color: var(--color-accent-hover);
  }
  .avatar-gallery__mark.is-current {
    color: var(--color-success);
  }
  .avatar-gallery__remove {
    position: absolute;
    top: 2px;
    right: 2px;
    z-index: 2;
    min-width: 0;
    width: 1.25rem;
    height: 1.25rem;
    padding: 0;
    line-height: 1;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .avatar-gallery__tile-wrap:hover .avatar-gallery__remove,
  .avatar-gallery__tile-wrap:focus-within .avatar-gallery__remove {
    opacity: 1;
  }
  .avatar-gallery__tip {
    margin: 4px 0 0;
    font-size: 0.62rem;
    min-height: 0;
  }
  .avatar-gallery__tip:empty {
    display: none;
  }
  .area-character .character-panel-divider {
    margin: 10px 0 12px;
  }
  .avatar-gallery__tip.is-warn {
    color: var(--color-warning, #fbbf24);
  }
  .avatar-gallery__tip.is-err {
    color: var(--color-danger, #f87171);
  }
  .character-version-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .character-version-row #characterVersion {
    flex: 0 1 120px;
    min-width: 88px;
    max-width: 160px;
    opacity: 0.92;
    cursor: default;
  }
  .character-version-row .btn-meta {
    opacity: 0.9;
  }
  /* 与 AI 引擎跳转按钮同款 */
  .ai-engine-link-btn {
    font-size: 0.68rem;
    padding: 2px 0;
    border: none;
    background: transparent;
    color: var(--color-accent);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .char-tags-add-row {
    display: flex;
    gap: 6px;
    align-items: center;
    flex-wrap: wrap;
  }
  .char-tag-input {
    flex: 1;
    min-width: 100px;
    padding: 5px 8px;
    font-size: 0.78rem;
  }
  .char-tags-add-row .btn {
    width: auto;
    min-width: 0;
    margin: 0;
    flex-shrink: 0;
  }
  .btn-ai-tag {
    background: var(--color-accent-soft);
    border-color: var(--color-accent-border);
    color: var(--color-accent-hover);
  }
  .btn-ai-tag:hover {
    background: oklch(76% 0.095 310 / 0.16);
    border-color: var(--color-accent);
    color: var(--color-text);
  }
  /* 头像 AI 生图弹窗 */
  .avatar-img-gen-body {
    display: flex;
    flex-direction: column;
  }
  .avatar-img-gen-meta {
    font-size: 0.72rem;
    color: var(--color-accent-hover);
    margin: 0 0 10px;
    font-weight: 600;
  }
  .img-gen-actions {
    display: flex;
    gap: 8px;
    align-items: center;
    margin: 10px 0 6px;
  }
  .img-gen-status {
    min-height: 1.2em;
    font-size: 0.72rem;
    color: var(--color-text-muted);
    margin: 0 0 10px;
  }
  .img-gen-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 10px;
    max-height: 340px;
    overflow-y: auto;
  }
  .img-gen-card {
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
    padding: 0;
    cursor: pointer;
    background: var(--color-surface-inset);
    transition: border-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .img-gen-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }
  .img-gen-card img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>

<script>
  import { initCharacterPanel } from '../lib/card-builder/characterPanelBoot.mjs';
  initCharacterPanel();
</script>
