---
import WorldbookPanelVue from './worldbook/WorldbookPanel.vue';
import WorldbookAuditor from './WorldbookAuditor.astro';
---
<WorldbookPanelVue client:only="vue" />

<style is:global>
  /* 标题行：左标题 右小号操作横排；动态列表节点需 global 才能吃到样式 */
  .area-worldbook .wb-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }
  .wb-panel-head h2 {
    margin: 0;
    flex-shrink: 0;
  }
  .wb-panel-head .wb-token-count {
    font-size: 0.68rem;
    flex-shrink: 0;
    margin-right: auto;
  }
  .wb-head-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 5px;
    margin-left: auto;
  }
  /* 小号横排：三 AI + 新建 */
  .wb-ai-open-btn,
  .wb-entry-create-btn {
    width: auto !important;
    margin: 0 !important;
    padding: 4px 8px !important;
    font-size: 0.66rem !important;
    line-height: 1.2 !important;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* 搜索区独占下方工具条 */
  .wb-toolbar {
    margin-bottom: 8px;
  }
  .wb-search-wrap {
    padding: 8px 10px;
    border-radius: 8px;
    background: var(--color-surface-inset);
    border: 1px solid var(--color-accent-border);
  }
  .wb-search-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--color-surface-input);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0 8px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .wb-search-bar:focus-within {
    border-color: var(--color-accent-border);
    box-shadow: 0 0 0 2px var(--color-accent-soft);
  }
  .wb-search-icon { font-size: 0.82rem; opacity: 0.7; }
  .wb-search-input {
    flex: 1;
    background: transparent !important;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    padding: 7px 0 !important;
    font-family: inherit;
    min-width: 0;
    border-radius: 0;
  }
  .wb-search-input::placeholder { color: var(--color-text-muted); }
  .wb-search-clear {
    background: var(--color-surface-inset);
    border: none;
    color: var(--color-text-muted);
    width: 20px;
    height: 20px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 0.68rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }
  .wb-search-clear:hover {
    background: var(--color-accent-soft-hover);
    color: var(--color-text);
  }
  .wb-search-scope {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    flex-wrap: wrap;
  }
  .wb-scope-tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: 6px;
    background: var(--color-chip-bg);
    border: 1px solid var(--color-chip-border);
    font-size: 0.68rem;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.2s ease;
    user-select: none;
    margin: 0;
    font-weight: normal;
  }
  .wb-scope-tag:hover {
    border-color: var(--color-accent-border);
    color: var(--color-text-secondary);
  }
  .wb-scope-tag input { display: none; }
  .wb-scope-tag:has(input:checked) {
    background: var(--color-accent-soft);
    border-color: var(--color-accent-border);
    color: var(--color-text);
  }
  .wb-search-count {
    margin-left: auto;
    font-size: 0.66rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .wb-family-filter {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    margin: 0;
  }
  .wb-family-select {
    font-size: 0.68rem;
    padding: 2px 6px;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: var(--color-surface-input);
    color: var(--color-text-secondary);
    max-width: 7rem;
  }

  /* 单列紧凑命中列表（非双列预览卡） */
  .wb-search-results {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 8px;
    max-height: 220px;
    overflow-y: auto;
    padding-right: 2px;
  }
  .wb-search-empty {
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.74rem;
    padding: 10px 8px;
  }
  .wb-search-hit {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 6px 8px;
    border-radius: 6px;
    border: 1px solid transparent;
    background: var(--color-surface-inset);
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
    min-width: 0;
  }
  .wb-search-hit:hover,
  .wb-search-hit:focus-visible {
    border-color: var(--color-accent-border);
    background: var(--color-accent-soft);
    outline: none;
  }
  .wb-search-hit-main {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    flex-wrap: wrap;
  }
  .wb-search-hit-title {
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
    max-width: 100%;
  }
  .wb-search-hit-fields {
    font-size: 0.62rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .wb-search-hit-fields strong {
    color: var(--color-accent-hover);
    font-weight: 600;
  }
  .wb-search-hit-snippet {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    line-height: 1.35;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .wb-search-hit mark {
    background: var(--color-warning-soft);
    color: var(--color-text);
    padding: 0 2px;
    border-radius: 3px;
    font-weight: 600;
  }

  /* AI 配置：真弹窗（fixed 全屏遮罩；打开时挂到 body） */
  .wb-modal[hidden] { display: none !important; }
  .wb-modal {
    position: fixed;
    inset: 0;
    z-index: 9200;
    display: grid;
    place-items: center;
    padding: 18px;
  }
  :global(body.wb-modal-open) {
    overflow: hidden;
  }
  .wb-modal-backdrop {
    position: absolute;
    inset: 0;
    background: var(--color-scrim);
    backdrop-filter: blur(6px);
  }
  .wb-modal-dialog {
    position: relative;
    z-index: 1;
    width: min(480px, 100%);
    border-radius: 12px;
    border: 1px solid var(--color-accent-border);
    background: var(--color-surface-elevated);
    box-shadow: var(--shadow-panel);
    overflow: hidden;
  }
  .wb-modal-dialog-lg { width: min(640px, 100%); }
  .wb-modal-body-scroll {
    max-height: min(62vh, 520px);
    overflow-y: auto;
  }
  .wb-modal-head {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px 10px;
    border-bottom: 1px solid var(--color-accent-soft);
  }
  .wb-modal-head strong {
    font-size: 0.9rem;
    color: var(--color-text);
  }
  .wb-modal-tip {
    font-size: 0.68rem;
    color: var(--color-text-muted);
  }
  .wb-modal-tip.is-err {
    color: var(--color-danger);
  }
  .wb-modal-body {
    padding: 12px 16px 8px;
  }
  .wb-modal-desc {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }
  .wb-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    padding: 12px 16px 14px;
    border-top: 1px solid var(--color-border);
  }
  .wb-modal-cancel {
    width: auto !important;
    margin: 0 !important;
    background: var(--color-surface-elevated);
    color: var(--color-text);
    border-color: var(--color-border);
    box-shadow: none;
  }
  .wb-modal-cancel:hover {
    background: var(--color-accent-soft);
    color: var(--color-text);
    border-color: var(--color-accent-border);
    box-shadow: none;
  }
  .wb-ai-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .wb-ai-row input[type="text"] {
    flex: 1;
    min-width: 0;
  }
  .wb-ai-action {
    width: auto !important;
    margin: 0 !important;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .wb-ai-checks {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
    flex-wrap: wrap;
  }
  .wb-ai-check {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.74rem;
    font-weight: normal;
    cursor: pointer;
  }

  /* 列表占满剩余高度；空态居中 tip 视觉（动态节点，依赖 is:global） */
  .area-worldbook .wb-entries-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 100%;
  }
  .area-worldbook .wb-entries-list.is-vl {
    gap: 0;
    display: block;
  }
  .area-worldbook .wb-entries-list.is-vl .entry-item {
    height: auto;
    min-height: 64px;
    margin: 0;
    box-sizing: border-box;
    overflow: hidden;
  }
  .area-worldbook .wb-entries-list.is-vl .entry-item-header {
    align-items: center;
  }
  .area-worldbook .wb-entries-list.is-vl .entry-actions {
    flex-wrap: nowrap;
    max-width: none;
  }
  .area-worldbook .wb-entries-empty {
    margin: auto;
    padding: 28px 18px;
    max-width: 28rem;
    width: calc(100% - 24px);
    text-align: center;
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.55;
    color: var(--color-text-muted);
    border: 1px dashed var(--color-accent-border);
    border-radius: 8px;
    background: var(--color-accent-soft);
    box-sizing: border-box;
  }

  @media (max-width: 720px) {
    .wb-panel-head {
      align-items: flex-start;
    }
    .wb-head-actions {
      width: 100%;
      justify-content: flex-start;
    }
  }
</style>

<div id="wbAuditorModal" class="panel-feature-modal" hidden aria-hidden="true">
  <div class="ui-modal-backdrop" data-wb-auditor-close aria-hidden="true"></div>
  <div class="ui-modal-dialog panel-feature-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="wbAuditorModalTitle">
    <div class="panel-feature-modal__head">
      <h2 id="wbAuditorModalTitle">世界书内容监测</h2>
      <button type="button" class="btn-icon btn-icon--sm" data-wb-auditor-close aria-label="关闭">×</button>
    </div>
    <div class="panel-feature-modal__body">
      <WorldbookAuditor />
    </div>
  </div>
</div>

<script is:inline>
(function() {
  var modal = document.getElementById('wbAuditorModal');
  if (!modal) return;
  function openModal() {
    if (modal.parentNode !== document.body) {
      if (!modal._home) modal._home = modal.parentNode;
      document.body.appendChild(modal);
    }
    modal.hidden = false;
    modal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('panel-feature-modal-open');
  }
  function closeModal() {
    modal.hidden = true;
    modal.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('panel-feature-modal-open');
    if (modal._home && modal.parentNode === document.body) {
      modal._home.appendChild(modal);
    }
  }
  window.__openWbAuditorModal__ = openModal;
  window.__closeWbAuditorModal__ = closeModal;
  var openBtn = document.getElementById('btnOpenWbAuditor');
  if (openBtn) openBtn.addEventListener('click', openModal);
  modal.querySelectorAll('[data-wb-auditor-close]').forEach(function(el) {
    el.addEventListener('click', closeModal);
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !modal.hidden) closeModal();
  });
})();
</script>
