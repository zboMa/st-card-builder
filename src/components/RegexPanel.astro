---
/**
 * 正则模块：管理当前角色卡 data.extensions.regex_scripts（与 MVU/状态栏注入共存）
 * Vue 岛负责视图；boot 负责写入与测试解析。
 */
import RegexPanelVue from './regex/RegexPanel.vue';
---
<RegexPanelVue client:only="vue" />

<style is:global>
  .rx-hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .rx-hero__sub {
    margin: 2px 0 0;
    display: block;
  }
  .rx-hero code {
    font-size: 0.72rem;
    color: var(--color-accent-hover);
  }
  .rx-hero-actions {
    display: flex;
    flex-shrink: 0;
    gap: 6px;
    align-items: center;
  }
  .rx-layout {
    display: grid;
    grid-template-columns: minmax(220px, 0.9fr) minmax(280px, 1.2fr);
    gap: var(--space-2);
  }
  @media (max-width: 900px) {
    .rx-layout { grid-template-columns: 1fr; }
  }
  .rx-list-card, .rx-editor-card {
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    background: var(--color-surface-input);
    box-shadow: var(--shadow-inset);
    min-height: 280px;
  }
  .rx-list-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }
  .rx-tip { color: var(--color-text-muted); }
  .rx-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: min(52vh, 480px);
    overflow-y: auto;
  }
  .rx-item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-2);
    align-items: center;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-subtle);
    background: var(--color-surface-inset);
    cursor: pointer;
    text-align: left;
    color: inherit;
    font: inherit;
    transition: border-color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }
  .rx-toggle {
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
    margin: 0;
    cursor: pointer;
    flex-shrink: 0;
  }
  .rx-item-actions button {
    position: relative;
    z-index: 1;
  }
  .rx-item.is-active {
    border-color: var(--color-accent-border);
    background: var(--color-entry-active-bg);
    box-shadow: inset 0 0 0 1px var(--color-accent-soft);
  }
  .rx-item.is-disabled { opacity: 0.55; }
  .rx-item-name {
    font-size: 0.8rem;
    font-weight: 650;
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rx-item-meta {
    font-size: 0.68rem;
    color: var(--color-text-muted);
  }
  .rx-item-actions {
    display: flex;
    gap: 4px;
  }
  .rx-icon-btn {
    width: 26px;
    height: 26px;
    min-width: 26px;
    padding: 0;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-subtle);
    background: var(--color-surface-inset);
    color: var(--color-text-muted);
    cursor: pointer;
    font: inherit;
    font-size: 0.72rem;
  }
  .rx-icon-btn:hover {
    border-color: var(--color-accent-border);
    background: var(--color-accent-soft);
    color: var(--color-text);
  }
  .rx-icon-btn.is-danger:hover {
    color: var(--color-danger);
    border-color: var(--color-danger-border);
    background: var(--color-danger-soft);
  }
  .rx-empty {
    margin: 24px 8px;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }
  .rx-editor-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }
  .rx-editor-head h3 {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text);
  }
  .rx-live-hint {
    font-size: 0.68rem;
    color: var(--color-text-muted);
  }
  .rx-live-hint.is-ok { color: var(--color-success); }
  .rx-live-hint.is-err { color: var(--color-danger); }
  .rx-field { margin-bottom: 10px; }
  .rx-field-tight { margin-bottom: 0; }
  .rx-label {
    display: block;
    margin-bottom: 4px;
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }
  .rx-field input[type="text"],
  .rx-field input[type="number"],
  .rx-field textarea {
    width: 100%;
    box-sizing: border-box;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-subtle);
    background: var(--color-surface-input);
    color: var(--color-text);
    padding: 8px 10px;
    font: inherit;
    font-size: 0.8rem;
  }
  .rx-field textarea { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; resize: vertical; }
  .rx-editor-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
    margin-top: 4px;
    padding-top: 10px;
    border-top: 1px solid var(--color-border-subtle);
  }
  @media (max-width: 700px) {
    .rx-editor-cols { grid-template-columns: 1fr; }
  }
  .rx-col {
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    padding: 10px;
    background: var(--color-surface-elevated);
  }
  .rx-section-title {
    margin: 0 0 8px;
    font-size: 0.72rem;
    font-weight: 650;
    color: var(--color-text-label);
  }
  .rx-col .rx-section-title:not(:first-child) { margin-top: 12px; }
  .rx-checks { display: flex; flex-wrap: wrap; gap: 8px 14px; }
  .rx-checks-stack { flex-direction: column; flex-wrap: nowrap; gap: 6px; }
  .rx-depth-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
    margin-top: 12px;
  }
  .rx-check {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.74rem;
    color: var(--color-text-secondary);
    cursor: pointer;
  }
  .rx-check input[type="checkbox"] {
    flex-shrink: 0;
    cursor: pointer;
  }
  .rx-status {
    margin-top: 8px;
    min-height: 1.2em;
    font-size: 0.74rem;
    color: var(--color-success);
  }
  .rx-status.is-err { color: var(--color-danger); }
  .rx-badge {
    display: inline-block;
    margin-left: 6px;
    padding: 1px 6px;
    border-radius: 999px;
    font-size: 0.62rem;
    background: var(--color-warning-soft);
    color: var(--color-warning);
    border: 1px solid var(--color-warning-border);
  }
  .rx-modal {
    position: fixed;
    inset: 0;
    z-index: 9300;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .rx-modal[hidden] { display: none !important; }
  :global(body.rx-modal-open) {
    overflow: hidden;
  }
  .rx-modal-backdrop {
    position: absolute;
    inset: 0;
  }
  .rx-modal-dialog {
    position: relative;
    z-index: 1;
    width: min(560px, 100%);
    max-height: min(84vh, 720px);
    overflow: auto;
    padding: 14px 16px;
  }
  .rx-modal-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: 10px;
  }
  .rx-modal-head strong {
    color: var(--color-text);
    font-size: 0.92rem;
  }
  .rx-modal-tip { font-size: 0.68rem; color: var(--color-text-muted); }
  .rx-modal-body { margin-bottom: 8px; }
  .rx-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-2);
  }
  .rx-modal-actions-inline {
    display: flex;
    justify-content: flex-end;
    margin: 0 0 10px;
  }
  .rx-test-err {
    margin: 0;
    font-size: 0.74rem;
    color: var(--color-danger);
  }
</style>

<script>
  import { initRegexPanel } from '../lib/regexPanelBoot.mjs';
  initRegexPanel();
</script>
